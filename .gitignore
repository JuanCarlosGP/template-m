# Artefactos locales, secretos y salidas regenerables — no commitear.
# Sí van al repo: código (maestro/), docs/, e2e-specs/, playbooks en docs/agent/.

node_modules/
build/
.maestro/
maestro/.maestro/
npm-debug.log*
yarn-debug.log*
.env
.env.local
maestro/scripts/gherkin-dictionary/reports/gherkin-extraction.json
maestro/scripts/gherkin-dictionary/reports/gherkin-extraction.csv

# Run artifacts (generated by gherkin-runner). The HTML viewer *template*
# lives in maestro/scripts/report-viewer/ (tracked); output lands here.
reports/**
!reports/.gitkeep

# Symlinks locales a docs/agent/ u otro wiring IDE legacy (opcional).
# Slash commands: .agents/skills/ (versionados) → docs/agent/.
.agents/
