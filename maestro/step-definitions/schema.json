{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Step definitions file",
  "description": "Maps Gherkin steps to Maestro flow names for the Izertis Maestro Template",
  "type": "object",
  "required": ["steps"],
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pattern", "flow"],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "flow": {
            "type": ["string", "null"]
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
