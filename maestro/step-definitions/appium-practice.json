{
  "steps": [
    {
      "pattern": "abro Appium Practice en la pantalla principal",
      "flow": "ExpandBankOpenApp",
      "description": "Launch Appium Practice with clear app state"
    },
    {
      "pattern": "veo el texto \"(.+)\"",
      "params": ["TEXT"],
      "flow": "AssertVisibleText",
      "description": "Assert visible copy on screen"
    },
    {
      "pattern": "entro en \"(.+)\" e inicio sesión con usuario \"(.+)\" y clave \"(.+)\"",
      "params": ["SECTION", "USERNAME", "PASSWORD"],
      "flow": "ExpandBankLoginForm",
      "description": "Open bank section and submit login form"
    },
    {
      "pattern": "entro en \"(.+)\"",
      "params": ["SECTION"],
      "flow": "TapAppSection",
      "description": "Open a home screen panel by visible title"
    },
    {
      "pattern": "el contador muestra \"(.+)\"",
      "params": ["VALUE"],
      "flow": "AssertCounterValue",
      "description": "Assert counter display value"
    },
    {
      "pattern": "pulso incrementar (\\d+) (?:veces|vez)",
      "params": ["TIMES"],
      "flow": "CounterIncrement",
      "description": "Tap the counter increment button N times"
    },
    {
      "pattern": "pulso decrementar (\\d+) (?:veces|vez)",
      "params": ["TIMES"],
      "flow": "CounterDecrement",
      "description": "Tap the counter decrement button N times"
    },
    {
      "pattern": "pulso reset del contador",
      "flow": "CounterReset",
      "description": "Tap the counter reset button"
    },
    {
      "pattern": "navego en el WebView a \"(.+)\"",
      "params": ["URL"],
      "flow": "WebViewNavigateUrl",
      "description": "Enter a URL in the WebView bar and tap GO"
    },
    {
      "pattern": "pulso clear del WebView",
      "flow": "WebViewClear",
      "description": "Tap CLEAR on the WebView screen"
    },
    {
      "pattern": "en el WebView veo el texto \"(.+)\"",
      "params": ["TEXT"],
      "flow": "AssertWebViewText",
      "description": "Wait for and assert text inside the loaded WebView"
    }
  ]
}
