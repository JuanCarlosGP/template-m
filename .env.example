# Copia a .env (ignorado por git):  cp .env.example .env
# Bootstrap: npm run setup
#
# Izertis Maestro Template — plantilla del framework Maestro+Gherkin.
#
# No hace falta .env para npm run check ni CI headless (validate/tests sin dispositivo).
# Obligatorio solo para ejecución en dispositivo y opcionales (Azure, BrowserStack).

# --- Core (app bajo test) ---

# Sauce Labs My Demo App (Android): https://github.com/saucelabs/my-demo-app-android
ANDROID_APP_ID=com.saucelabs.mydemoapp.android
# iOS (cuando se añadan escenarios): com.saucelabs.mydemoapp.ios
IOS_APP_ID=com.saucelabs.mydemoapp.ios
ANDROID_APP_NAME=My Demo App
IOS_APP_NAME=My Demo App
# APP_NAME=My Demo App
# Fallback si no defines ANDROID_APP_NAME / IOS_APP_NAME por separado.

# No lo lee ningún script — la plataforma se pasa por CLI: --platform android|ios|all
PLATFORM=all

# Opcional: inyectar credenciales al runner con --username / --password.
USERNAME=
PASSWORD=

# Checkout local de la app (selectores, agentes). No necesario para npm run check.
APP_SOURCE_DIR=../your-mobile-app

# --- Reporting (post-ejecución) ---

REPORT_DIR=reports

# --- Azure DevOps (opcional — omitir todo el bloque si no publicas en Test Plans) ---

AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=

AZURE_TEST_PLAN_ID=0
AZURE_TEST_SUITE_ID=0
# Alias legacy (opcional): PLAN_ID y SUITE_ID siguen soportados por el runner.
# AZURE_TEST_CASE_ID=0
# Solo si publicas sin testCaseId por escenario (modo single-case).

# --- Build paths (convención manual — ningún script del fw los lee) ---
# Ver docs/DEVICE.md: copiar APK/.app desde ANDROID_SRC/IOS_SRC a estas rutas.

ANDROID_BUILD=build/android/demo.apk
IOS_BUILD=build/ios/DemoApp.app
ANDROID_SRC=
IOS_SRC=

# --- Maestro CLI (opcional) ---

# MAESTRO_CLI=$HOME/.maestro/bin/maestro

# --- Java 17+ (opcional) ---

# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# --- Maestro session (opcional — CI multi-worker) ---

# MAESTRO_KEEP_SESSION=1

# --- Android device (opcional) ---

# ANDROID_SERIAL=emulator-5554

# --- BrowserStack (opcional — omitir si ejecutas solo en local/emulador) ---
# Lista completa de variables: cabecera de maestro/scripts/browserstack-adapter.js

# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# BROWSERSTACK_ANDROID_DEVICE=
# BROWSERSTACK_IOS_DEVICE=
# MOCK_SERVER_URL=http://localhost:3000
# Requerido con gherkin-runner --executor browserstack --environment mock

# --- IDE MCP (opcional — no lo lee ningún script npm; ver docs/agent/mcp-examples.md) ---

# GITHUB_TOKEN=
# PAT para el MCP de GitHub en .mcp.json (issues/PRs). GitLab MCP usa OAuth en el IDE.
